# Builds the demo API from packages/demo (uses tsx + the `apidock-source` export condition,
# so it runs the workspace sources directly — example purposes only).
#   docker build -f docker/Dockerfile.demo -t apidock-demo .
FROM node:24-alpine
WORKDIR /app
RUN corepack enable
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY packages ./packages
RUN pnpm install --frozen-lockfile --filter @apidock/demo...
EXPOSE 3000
CMD ["pnpm", "--filter", "@apidock/demo", "start"]
