{
  "name": "apidock",
  "version": "0.1.0",
  "description": "Self-hosted, Apidog-style API devtools for Node.js: code-first OpenAPI, docs, try-it-out client, mock server and contract testing.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "openapi",
    "swagger",
    "api",
    "docs",
    "mock",
    "contract-testing",
    "express",
    "zod"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "ui-dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "apidock": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "apidock-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "apidock-source": "./src/express/index.ts",
      "types": "./dist/express/index.d.ts",
      "default": "./dist/express/index.js"
    },
    "./server": {
      "apidock-source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "express": "^5.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@faker-js/faker": "10.6.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsonpath-plus": "11.1.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/supertest": "7.2.1",
    "express": "5.2.1",
    "supertest": "7.3.1",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
